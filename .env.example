# HTTP 服务端口；如需绑定指定地址可改用 SERVER_ADDRESS
SERVER_PORT=8080

# 当前启用的模型供应商：openai 或 deepseek
LLM_PROVIDER=deepseek
LLM_REQUEST_TIMEOUT=60s
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_INTERVAL=200ms
LLM_RETRY_MAX_INTERVAL=2s

# 单次 Agent 运行允许的最大 LLM 决策次数
AGENT_MAX_STEPS=8
# 单次 LLM 请求的估算 prompt token 上限（含消息与工具定义）；超出则丢掉最旧轮次
AGENT_CONTEXT_TOKENS=8192
# 单次回复的最大输出 token，写入模型 MaxTokens
AGENT_MAX_OUTPUT_TOKENS=2048

# PostgreSQL；填写 Linux 服务器地址，部署步骤见 docs/deploy-postgres-linux.md
# Docker 访问宿主机 5432 时把主机名改成 host.docker.internal，不要用 127.0.0.1
DATABASE_URL=postgres://chat_agent:replace-with-db-password@your-postgres-host:5432/chat_agent?sslmode=disable

# JWT；JWT_SECRET 必须替换为随机值
JWT_SECRET=replace-me
JWT_ACCESS_TTL=168h
JWT_ISSUER=chat-agent

# OpenAI 或 OpenAI 兼容网关；chat-gpt-luna 是预期使用的网关模型别名
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=chat-gpt-luna

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
