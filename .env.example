# HTTP 服务端口；如需绑定指定地址可改用 SERVER_ADDRESS
SERVER_PORT=8080

# 当前启用的模型供应商：openai 或 deepseek
LLM_PROVIDER=deepseek
LLM_REQUEST_TIMEOUT=60s
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_INTERVAL=200ms
LLM_RETRY_MAX_INTERVAL=2s

# 单次 Agent 运行允许的最大 LLM 决策次数
AGENT_MAX_STEPS=8

# 单用户认证；仅配置 bcrypt 哈希，不填写密码明文
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD_HASH=replace-with-bcrypt-password-hash

# JWT；JWT_SECRET 必须替换为至少 32 字节的随机值
JWT_SECRET=replace-me
JWT_ACCESS_TTL=168h
JWT_ISSUER=chat-agent

# OpenAI 或 OpenAI 兼容网关；chat-gpt-luna 是预期使用的网关模型别名
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=chat-gpt-luna

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
